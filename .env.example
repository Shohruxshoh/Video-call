# Settings for docker-compose.yml. deploy/install.sh creates .env from these on the first run.
DOMAIN=video.n-shohrux.uz
# Public IPv4 of the server. TURN (calls) goes here directly: Cloudflare doesn't pass UDP.
PUBLIC_IP=46.224.22.135
# Shared secret between the app and coturn; install.sh generates a random one.
TURN_SECRET=
# The "web" container listens here on localhost; the server's nginx forwards to it.
WEB_PORT=8090
# Certificate the server's nginx uses for DOMAIN (Cloudflare Origin certificate).
SSL_CERT=/etc/nginx/ssl/n-shohrux.crt
SSL_KEY=/etc/nginx/ssl/n-shohrux.key
