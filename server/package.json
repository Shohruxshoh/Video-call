{
  "name": "onlinevideo-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "seed:dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed-dev.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "check": "tsc -p ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^6.0.3"
  }
}
