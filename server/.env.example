# Copy to server/.env for local overrides. Every value is optional in development.
# In production docker-compose.yml sets these from the root .env file.

# NODE_ENV=production
# HOST=127.0.0.1
# PORT=3210
# Public address of the app; invite links are built from it.
# PUBLIC_URL=http://localhost:5173
# DB_PATH=./data/app.db
# Extra origins allowed to call the API (comma-separated).
# ALLOWED_ORIGINS=
# coturn: address and its shared secret (static-auth-secret). Use the IP (or a DNS-only
# hostname) when the site is behind Cloudflare: Cloudflare doesn't pass TURN traffic.
# TURN_HOST=46.224.22.135
# TURN_SECRET=
# TURN_TLS=1   only if coturn also listens with a certificate on 5349

# LOG_LEVEL=info
